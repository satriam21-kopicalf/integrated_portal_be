# Supabase PostgreSQL (session pooler) - same credentials as the ESB sync engine
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.awcoxytlmjiyfmpzinam
DB_PASSWORD=change_me
DB_SSLMODE=require
DB_POOL_MIN=1
DB_POOL_MAX=5

# Excel export jobs
# EXPORT_DIR=/data/exports        (set by the Dockerfile)
EXPORT_TTL_HOURS=24
EXPORT_MAX_CONCURRENT=2
# Absolute base for download links, e.g. https://portal-api.kopicalf.co.id
# Empty = relative /api/exports/{id}/download (served through the Vercel proxy)
PUBLIC_BASE_URL=

# Export to Google Sheets (empty = option hidden); see README "Export Google Sheets"
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# or a service account key (base64) with a folder on a Shared Drive
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_SHARE_ROLE=writer

# Server
PORT=8002
# Comma separated, e.g. https://integrated-portal.vercel.app,http://localhost:3002
CORS_ORIGINS=*
TIMEZONE=Asia/Jakarta
