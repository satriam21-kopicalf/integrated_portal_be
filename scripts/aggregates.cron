# integrated_portal_be: rebuild Overview aggregates (integration_portal schema).
# Installed as /etc/cron.d/integrated-portal-aggregates. Server clock is UTC (WIB = UTC+7).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# after the hourly ESB sync (:05, ~3 min): today + yesterday
20 * * * * root bash /opt/integrated-portal-be/repo/scripts/aggregates.sh --recent 2 >> /var/log/integrated-portal-aggregates.log 2>&1

# Right after every ESB sales sync (:05 hourly, :20/:35/:50 during 06:00-24:00 WIB) the ESB cron itself runs
# aggregates.sh (integrated-esbapi deploy/esb-integration.cron); the :20 run above is the hourly safety net.

# after the nightly 7-day ESB resync (02:15 WIB): last 8 days, 02:50 WIB
50 19 * * * root bash /opt/integrated-portal-be/repo/scripts/aggregates.sh --recent 8 >> /var/log/integrated-portal-aggregates.log 2>&1

# housekeeping, 03:30 WIB: activity log > ACTIVITY_RETENTION_DAYS (90), Google Sheets exports > GSHEET_RETENTION_DAYS (30)
30 20 * * * root docker exec integrated-portal-be python -m app.maintenance >> /var/log/integrated-portal-maintenance.log 2>&1

# Rating & Review -> Google Maps (Places API): match new outlets, refresh rating / reviews / hours, 06:10 WIB
10 23 * * * root docker exec integrated-portal-be python -m app.gmaps >> /var/log/integrated-portal-gmaps.log 2>&1
